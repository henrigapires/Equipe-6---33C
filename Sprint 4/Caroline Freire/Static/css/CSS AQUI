body{
  background-color: #f2ece3;
  font-size: 14px;
}

.navbar{
  display: flex;
  align-items: center;
  border-bottom: 1px solid #d8cec2;
}

nav{
  flex: 1;
  text-align: right;
}

nav ul li{
  display: inline-block;
  margin-right: 20px;
}

a{
  text-decoration: none;
  color: #8b3a1a;
}

.link-menu{
  color: #5b4a3d;
  font-weight: bold;
}

.color{
  color: #8b3a1a;
  font-weight: bold;
}

.conteudo{
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 10px;
}

.grades{
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10px;
}

.caixa{
  width: 48%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 5px;
  border-radius: 15px;
  background-color: #faf7f1;
  border: 1px solid #d8cec2;
}

.topo-caixa{
  display: flex;
  align-items: center;
  gap: 10px;
}

.etiqueta{
  background-color: #5d5f2e;
  color: white;
  padding: 3px 8px;
  border-radius: 8px;
}

.botao{
  background-color: #8b3a1a;
  color: white;
  padding: 3px 10px;
  border-radius: 10px;
}

table{
  width: 100%;
}

th{
  background-color: #e8dfd6;
}

